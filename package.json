{
  "name": "jmi-openatom-knowledge-os",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAtom 社团智能资料库系统",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "pnpm --filter @openatom/desktop dev",
    "dev:web": "pnpm --filter @openatom/desktop dev:web",
    "build": "pnpm --filter @openatom/ui build && pnpm --filter @openatom/desktop build",
    "build:desktop": "pnpm --filter @openatom/desktop dist",
    "typecheck": "pnpm --filter @openatom/ui typecheck && pnpm --filter @openatom/desktop typecheck"
  }
}
