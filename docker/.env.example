# ─────────────────────────────────────────────
# OpenAtom Knowledge OS — 环境变量配置
# 复制此文件为 .env 并修改对应值
# ─────────────────────────────────────────────

# MySQL
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=openatom_knowledge
MYSQL_USER=openatom
MYSQL_PASSWORD=openatom123
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ACCESS_KEY=openatom
MINIO_SECRET_KEY=openatom123
MINIO_BUCKET=knowledge-files
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Elasticsearch
ELASTICSEARCH_PORT=9200

# 后端
BACKEND_PORT=8080

# OIDC 认证
OIDC_ISSUER=https://oauth.jmi-openatom.cn/api/v1
OIDC_INTROSPECTION_URI=https://oauth.jmi-openatom.cn/api/v1/oauth/introspect
APP_SECURITY_DEV_MODE=false

# AI 配置
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
