# API 配置 — 生产环境
VITE_API_BASE_URL=https://api-os.jmi-openatom.cn/api
VITE_ENABLE_MOCK_FALLBACK=false

# OAuth2/OIDC 配置 (Electron 主进程使用)
OPENATOM_OIDC_ISSUER=https://oauth.jmi-openatom.cn/api/v1
OPENATOM_OIDC_CLIENT_ID=openatom-knowledge-desktop
OPENATOM_OIDC_CALLBACK_PORT=47832

# Vite 前端使用的环境变量
VITE_OIDC_ISSUER=https://oauth.jmi-openatom.cn/api/v1
VITE_OIDC_CLIENT_ID=openatom-knowledge-desktop
