{
  "name": "@openatom/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAtom Knowledge OS Electron desktop client",
  "author": "JMI OpenAtom",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmi-openatom/openatom-knowledge-os.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "dist": "pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@openatom/ui": "workspace:*",
    "@tabler/icons-vue": "^3.34.0",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.7.14",
    "@vue-office/pptx": "^1.0.1",
    "axios": "^1.10.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.2.0",
    "marked": "^15.0.12",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.30",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.1.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vue-tsc": "^2.2.10",
    "wait-on": "^8.0.3"
  }
}
