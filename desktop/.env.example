# API 配置
VITE_API_BASE_URL=http://127.0.0.1:8080/api
VITE_ENABLE_MOCK_FALLBACK=true

# OAuth2/OIDC 配置 (Electron 主进程使用)
# 根据 oauth-usage.md 文档，必须包含 /api/v1
OPENATOM_OIDC_ISSUER=https://oauth.jmi-openatom.cn/api/v1
OPENATOM_OIDC_CLIENT_ID=openatom-knowledge-desktop
OPENATOM_OIDC_CALLBACK_PORT=47832

# Vite 前端使用的环境变量(可选,与上面保持一致)
VITE_OIDC_ISSUER=${OPENATOM_OIDC_ISSUER}
VITE_OIDC_CLIENT_ID=${OPENATOM_OIDC_CLIENT_ID}
